# --- Smush específico ---
# Fuentes descargadas con scripts/fetch_fonts.py (se regeneran con uv run python scripts/fetch_fonts.py)
# Descomenta la siguiente línea si NO querés versionar las TTF (requiere fetch en cada clon):
# assets/fonts/*.ttf
# assets/fonts/
.atl

# Jobs temporales del compresor (en producción viven en tempfile.gettempdir()/image-compressor-jobs)
# Si alguna vez se configuran dentro del repo:
image-compressor-jobs/
tmp/
temp/

# Archivos generados al probar compresión local
*.zip
!tests/**/*.zip
output/
out/

# --- Docker ---
.dockerignore.bak
